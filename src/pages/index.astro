---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
	title="Home"
	description="The personal portfolio of Liam Wong — a place for projects, ideas, and a little about me."
>
	<section class="home-hero">
		<div class="hero-copy">
			<p class="eyebrow">A little corner of the internet</p>
			<h1>Hi, I’m Liam.<br />I make things for the <span class="highlight">web.</span></h1>
			<p class="lede">
				This is my home online: a place to share what I’m working on, what I’m learning,
				and the projects I’m proud of.
			</p>
			<div class="hero-actions">
				<a class="button button-dark" href={`${base}projects`}>Explore my projects <span aria-hidden="true">↗</span></a>
				<a class="text-link" href={`${base}about`}>A little about me <span aria-hidden="true">→</span></a>
			</div>
		</div>
		<div class="hero-art">
			<img
				class="hero-photo"
				src={`${base}unnamed%20(1).jpg`}
				alt="Portrait of Liam Wong from the shoulders up"
				width="1500"
				height="2250"
			/>
		</div>
	</section>

	<section class="home-bottom" aria-label="Explore the site">
		<p class="section-label">Take a look around</p>
		<div class="quick-links">
			<a href={`${base}about`}>
				<span class="quick-number">01</span>
				<span class="quick-title">About me</span>
				<span class="quick-arrow" aria-hidden="true">↗</span>
			</a>
			<a href={`${base}projects`}>
				<span class="quick-number">02</span>
				<span class="quick-title">Selected projects</span>
				<span class="quick-arrow" aria-hidden="true">↗</span>
			</a>
			<a href={`${base}contact`}>
				<span class="quick-number">03</span>
				<span class="quick-title">Get in touch</span>
				<span class="quick-arrow" aria-hidden="true">↗</span>
			</a>
		</div>
	</section>
</SiteLayout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 26px;
		padding: 83px 0 74px;
	}

	.hero-copy h1 {
		font-size: clamp(52px, 7vw, 78px);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 25px;
		margin-top: 34px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		transition: transform 160ms ease, background 160ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-dark {
		padding: 15px 19px;
		background: var(--ink);
		color: #fff;
	}

	.button-dark:hover {
		background: #34483c;
	}

	.text-link {
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
	}

	.text-link span {
		margin-left: 5px;
		color: #688b30;
	}

	.hero-art {
		position: relative;
		display: grid;
		width: min(100%, 390px);
		aspect-ratio: 1;
		place-items: center;
		justify-self: end;
		overflow: hidden;
		border-radius: 50%;
		background: #e7e9dc;
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: scale(3.2);
		transform-origin: 50% 22.5%;
	}

	.home-bottom {
		padding: 28px 0 53px;
		border-top: 1px solid var(--line);
	}

	.quick-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
		margin-top: 19px;
	}

	.quick-links a {
		display: grid;
		grid-template-columns: 34px 1fr 20px;
		align-items: center;
		gap: 9px;
		min-height: 67px;
		padding: 0 17px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fbfaf6;
		transition: border-color 160ms ease, transform 160ms ease;
	}

	.quick-links a:hover {
		border-color: #b6c096;
		transform: translateY(-2px);
	}

	.quick-number {
		color: #8c9389;
		font-family: "DM Mono", monospace;
		font-size: 10px;
	}

	.quick-title {
		font-size: 13px;
		font-weight: 600;
	}

	.quick-arrow {
		justify-self: end;
		color: #718b48;
	}

	@media (max-width: 800px) {
		.home-hero {
			grid-template-columns: 1fr 0.65fr;
			padding: 72px 0 60px;
		}

		.hero-art {
			width: 100%;
		}

	}

	@media (max-width: 620px) {
		.home-hero {
			grid-template-columns: 1fr;
			padding: 63px 0 47px;
		}

		.hero-art {
			width: min(80%, 300px);
			justify-self: center;
		}

		.quick-links {
			grid-template-columns: 1fr;
			gap: 9px;
		}
	}

	@media (max-width: 420px) {
		.hero-actions {
			align-items: flex-start;
			flex-direction: column;
			gap: 18px;
		}
	}
</style>
