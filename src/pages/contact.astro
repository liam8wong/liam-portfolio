---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
	title="Contact"
	description="Get in touch with Liam Wong."
>
	<section class="page-intro contact-intro">
		<div class="contact-copy">
			<p class="eyebrow">Open the conversation</p>
			<h1>Let’s talk <span class="highlight">soon.</span></h1>
			<p class="lede">
				Feel free to reach out! Contact me via email at liam8wong@gmail.com or by phone at (408)-372-8338. I'd be
				happy to hear from you!
			</p>
		</div>
		<div class="contact-portrait">
			<img
				src={`${base}unnamed%20(1).jpg`}
				alt="Portrait of Liam Wong from the shoulders up"
				width="1500"
				height="2250"
			/>
		</div>
	</section>

	<section class="contact-card panel">
		<div class="contact-symbol" aria-hidden="true">↗</div>
		<div>
			<p class="section-label">Make it yours</p>
			<h2>Your inbox, your way.</h2>
			<p>
				You can add an email address or a social link to this page whenever you’re ready.
				Until then, explore the rest of the site.
			</p>
			<a class="contact-link" href={`${base}projects`}>Browse projects <span aria-hidden="true">→</span></a>
		</div>
	</section>
</SiteLayout>

<style>
	.page-intro h1 {
		font-size: clamp(54px, 8vw, 82px);
	}

	.contact-intro {
		display: grid;
		max-width: none;
		grid-template-columns: minmax(0, 1fr) 250px;
		align-items: center;
		gap: 56px;
	}

	.contact-portrait {
		display: block;
		width: 250px;
		height: 250px;
		flex: 0 0 250px;
		overflow: hidden;
		border: 3px solid rgba(24, 37, 31, 0.12);
		border-radius: 50%;
		clip-path: circle(50% at 50% 50%);
	}

	.contact-portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: scale(3.2);
		transform-origin: 50% 22.5%;
	}

	.contact-card {
		display: grid;
		grid-template-columns: 74px 1fr;
		gap: 24px;
		max-width: 720px;
		margin-bottom: 78px;
		padding: 32px;
	}

	.contact-symbol {
		display: grid;
		width: 68px;
		height: 68px;
		place-items: center;
		border-radius: 50%;
		background: var(--green);
		font-size: 28px;
	}

	.contact-card h2 {
		margin: 15px 0 10px;
		font-size: clamp(27px, 4vw, 38px);
		font-weight: 600;
	}

	.contact-card > div:last-child > p:not(.section-label) {
		max-width: 480px;
		margin-bottom: 18px;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.75;
	}

	.contact-link {
		font-size: 13px;
		font-weight: 600;
	}

	.contact-link span {
		margin-left: 5px;
		color: #718b48;
	}

	@media (max-width: 640px) {
		.contact-intro {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.contact-portrait {
			width: min(100%, 240px);
			height: 240px;
			flex-basis: 240px;
		}
	}

	@media (max-width: 540px) {
		.contact-card {
			grid-template-columns: 1fr;
			gap: 21px;
			margin-bottom: 52px;
			padding: 24px;
		}
	}
</style>
