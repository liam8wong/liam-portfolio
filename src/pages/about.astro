---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
	title="About me"
	description="Get to know Liam Wong and the ideas behind this portfolio."
>
	<section class="page-intro">
		<p class="eyebrow">A little context</p>
		<h1>A bit <span class="highlight">about me.</span></h1>
		<p class="lede">
			I’m Liam Wong. I am a second year civil engineering major at Cal Poly Pomona. I made this space to expand on projects I've created and explored. 
		</p>
	</section>

	<section class="about-grid" aria-label="About this site">
		<div class="about-main panel">
			<p class="section-label">The short version</p>
			<h2>Curiosity first.<br />Make it with care.</h2>
			<p>
				I’m interested in making useful things for the web and learning through the process.
				I value clear ideas, thoughtful details, and work that feels good to use.
			</p>
			<p>
				This portfolio is a work in progress. As I add projects and more of my story, you’ll
				find them here.
			</p>
		</div>
		<aside class="about-side panel">
			<div class="about-portrait">
				<img
					src={`${base}unnamed%20(1).jpg`}
					alt="Portrait of Liam Wong from the shoulders up"
					width="1500"
					height="2250"
				/>
			</div>
			<p class="section-label">A small reminder</p>
			<p class="side-quote">“Stay curious.<br />Keep making.”</p>
			<span class="side-caption">A good place to start</span>
		</aside>
	</section>
</SiteLayout>

<style>
	.page-intro {
		padding-bottom: 54px;
	}

	.page-intro h1 {
		font-size: clamp(54px, 8vw, 82px);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.45fr 0.75fr;
		gap: 16px;
		padding-bottom: 75px;
	}

	.about-main {
		padding: 35px 38px;
	}

	.about-main h2 {
		margin: 24px 0 18px;
		font-size: clamp(32px, 4vw, 46px);
		font-weight: 600;
		line-height: 1.08;
	}

	.about-main > p:not(.section-label) {
		max-width: 590px;
		margin-bottom: 14px;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

	.about-main > p:last-child {
		margin-bottom: 0;
	}

	.about-side {
		display: flex;
		min-height: 300px;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: 30px;
		background: var(--green);
	}

	.about-portrait {
		display: block;
		width: 160px;
		height: 160px;
		aspect-ratio: 1;
		flex: 0 0 160px;
		margin: 0 auto auto;
		overflow: hidden;
		border: 3px solid rgba(24, 37, 31, 0.12);
		border-radius: 50%;
		clip-path: circle(50% at 50% 50%);
	}

	.about-portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: scale(3.2);
		transform-origin: 50% 22.5%;
	}

	.about-side .section-label {
		color: #536341;
	}

	.side-quote {
		margin: 13px 0 12px;
		font-family: Manrope, sans-serif;
		font-size: clamp(25px, 3vw, 34px);
		font-weight: 600;
		letter-spacing: -0.055em;
		line-height: 1.12;
	}

	.side-caption {
		color: #536341;
		font-size: 12px;
	}

	@media (max-width: 680px) {
		.about-grid {
			grid-template-columns: 1fr;
			padding-bottom: 52px;
		}

		.about-main {
			padding: 28px 24px;
		}

		.about-side {
			min-height: 230px;
		}
	}
</style>
